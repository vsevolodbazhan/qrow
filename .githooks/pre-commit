#!/bin/sh
set -eu
if ! command -v git >/dev/null 2>&1; then
    echo 'Missing required command: git' >&2
    exit 1
fi
repository="$(git rev-parse --show-toplevel)"
printf '%s\n' 'Checking the staged snapshot…'
QROW_CHANGED_FILES="$(git diff --cached --name-only)"
export QROW_CHANGED_FILES
sh "$repository/scripts/hooks/snapshot.sh" "$(git write-tree)" hook
