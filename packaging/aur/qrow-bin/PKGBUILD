# Maintainer: Vsevolod Bazhan <work@bazhan.one>

pkgname=qrow-bin
_pkgname=qrow
pkgver=0.4.0
pkgrel=1
pkgdesc='Native SQL workbench (release build)'
arch=('x86_64' 'aarch64')
url='https://qrow.dev'
license=('MIT')
depends=('gcc-libs' 'glibc' 'libxcb' 'libxkbcommon' 'libxkbcommon-x11' 'vulkan-icd-loader' 'wayland')
optdepends=(
  'gnome-keyring: Secret Service provider for saved passwords'
  'vulkan-driver: GPU rendering'
  'xdg-desktop-portal: file dialogs'
  'xdg-utils: open files with other applications'
)
provides=("$_pkgname=$pkgver")
conflicts=("$_pkgname")
options=('!strip' '!debug')
_release="https://github.com/vsevolodbazhan/qrow/releases/download/v$pkgver"
source_x86_64=("$_release/Qrow-$pkgver-linux-x86_64.tar.gz")
source_aarch64=("$_release/Qrow-$pkgver-linux-aarch64.tar.gz")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
  install -Dm755 bin/qrow -t "$pkgdir/usr/bin"
  install -Dm644 share/applications/qrow.desktop -t "$pkgdir/usr/share/applications"
  install -Dm644 share/icons/hicolor/256x256/apps/qrow.png -t "$pkgdir/usr/share/icons/hicolor/256x256/apps"
  install -Dm644 share/licenses/qrow/* -t "$pkgdir/usr/share/licenses/$pkgname"
}
