# Maintainer: Vsevolod Bazhan <work@bazhan.one>

pkgname=qrow
pkgver=0.4.0
pkgrel=1
pkgdesc='Native SQL workbench'
arch=('x86_64' 'aarch64')
url='https://qrow.dev'
license=('MIT')
depends=('gcc-libs' 'glibc' 'libxcb' 'libxkbcommon' 'libxkbcommon-x11' 'vulkan-icd-loader' 'wayland')
makedepends=('cargo' 'cmake' 'fontconfig' 'freetype2' 'git' 'libx11' 'uv' 'vulkan-headers')
optdepends=(
  'gnome-keyring: Secret Service provider for saved passwords'
  'vulkan-driver: GPU rendering'
  'xdg-desktop-portal: file dialogs'
  'xdg-utils: open files with other applications'
)
conflicts=('qrow-bin')
options=('!lto')
source=("git+https://github.com/vsevolodbazhan/qrow.git#tag=v$pkgver")
sha256sums=('SKIP')

prepare() {
  cd qrow
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd qrow
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  QROW_RELEASE_VERSION="$pkgver" QROW_DIST_DIR="$srcdir/dist" sh scripts/package/linux.sh
  rm -rf "$srcdir/stage"
  mkdir "$srcdir/stage"
  tar -xzf "$srcdir/dist/Qrow-$pkgver-linux-$CARCH.tar.gz" -C "$srcdir/stage"
}

package() {
  cd stage
  install -Dm755 bin/qrow -t "$pkgdir/usr/bin"
  install -Dm644 share/applications/qrow.desktop -t "$pkgdir/usr/share/applications"
  install -Dm644 share/icons/hicolor/256x256/apps/qrow.png -t "$pkgdir/usr/share/icons/hicolor/256x256/apps"
  install -Dm644 share/licenses/qrow/* -t "$pkgdir/usr/share/licenses/$pkgname"
}
